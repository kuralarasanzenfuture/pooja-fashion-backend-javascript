{
  "info": {
    "_postman_id": "a1b2c3d4-e5f6-47a8-b9c0-123456789abc",
    "name": "Pooja Fashion - Product Master: Product Types",
    "description": "API collection for Product Types under Product Master in Pooja Fashion ERP & POS platform.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "List Product Types",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/product-master/product-types?page=1&limit=10&company_id=1&is_active=true&sortBy=type_name&sortOrder=asc",
          "host": ["{{baseUrl}}"],
          "path": ["api", "product-master", "product-types"],
          "query": [
            { "key": "page", "value": "1" },
            { "key": "limit", "value": "10" },
            { "key": "company_id", "value": "1" },
            { "key": "is_active", "value": "true" },
            { "key": "search", "value": "", "disabled": true },
            { "key": "sortBy", "value": "type_name" },
            { "key": "sortOrder", "value": "asc" }
          ]
        }
      }
    },
    {
      "name": "Get Product Type by ID",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/product-master/product-types/{{productTypeId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "product-master", "product-types", "{{productTypeId}}"]
        }
      }
    },
    {
      "name": "Get Product Type by Code",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/product-master/product-types/code/{{companyId}}/{{typeCode}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "product-master", "product-types", "code", "{{companyId}}", "{{typeCode}}"]
        }
      }
    },
    {
      "name": "Get Company Product Types",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/product-master/product-types/company/{{companyId}}?is_active=true",
          "host": ["{{baseUrl}}"],
          "path": ["api", "product-master", "product-types", "company", "{{companyId}}"],
          "query": [{ "key": "is_active", "value": "true" }]
        }
      }
    },
    {
      "name": "Create Product Type",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"company_id\": 1,\n  \"type_code\": \"READY_MADE\",\n  \"type_name\": \"Ready Made Garments\",\n  \"description\": \"Finished apparel and ready-to-wear clothing\",\n  \"is_stock_item\": true,\n  \"is_saleable\": true,\n  \"is_purchasable\": true,\n  \"is_active\": true\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/product-master/product-types",
          "host": ["{{baseUrl}}"],
          "path": ["api", "product-master", "product-types"]
        }
      }
    },
    {
      "name": "Update Product Type",
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"type_name\": \"Ready-Made Garments & Outfits\",\n  \"description\": \"Finished apparel, pret-a-porter, and designer garments\",\n  \"is_stock_item\": true,\n  \"is_saleable\": true,\n  \"is_purchasable\": true,\n  \"is_active\": true\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/product-master/product-types/{{productTypeId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "product-master", "product-types", "{{productTypeId}}"]
        }
      }
    },
    {
      "name": "Update Product Type Status",
      "request": {
        "method": "PATCH",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"is_active\": false\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/product-master/product-types/{{productTypeId}}/status",
          "host": ["{{baseUrl}}"],
          "path": ["api", "product-master", "product-types", "{{productTypeId}}", "status"]
        }
      }
    },
    {
      "name": "Delete Product Type",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/product-master/product-types/{{productTypeId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "product-master", "product-types", "{{productTypeId}}"]
        }
      }
    },
    {
      "name": "Seed Default Product Types",
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/product-master/product-types/company/{{companyId}}/seed-defaults",
          "host": ["{{baseUrl}}"],
          "path": ["api", "product-master", "product-types", "company", "{{companyId}}", "seed-defaults"]
        }
      }
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000", "type": "string" },
    { "key": "companyId", "value": "1", "type": "string" },
    { "key": "productTypeId", "value": "1", "type": "string" },
    { "key": "typeCode", "value": "READY_MADE", "type": "string" }
  ]
}
