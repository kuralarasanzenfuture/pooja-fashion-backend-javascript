  "item": [
    {
      "name": "List Colors",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/product-master/colors?page=1&limit=10&company_id=1&is_active=true&sortBy=display_order&sortOrder=asc",
          "host": ["{{baseUrl}}"],
          "path": ["api", "product-master", "colors"],
          "query": [
            { "key": "page", "value": "1" },
            { "key": "limit", "value": "10" },
            { "key": "company_id", "value": "1" },
            { "key": "is_active", "value": "true" },
            { "key": "search", "value": "", "disabled": true },
            { "key": "sortBy", "value": "display_order" },
            { "key": "sortOrder", "value": "asc" }
          ]
        }
      }
    },
    {
      "name": "Get Color by ID",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/product-master/colors/{{colorId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "product-master", "colors", "{{colorId}}"]
        }
      }
    },
    {
