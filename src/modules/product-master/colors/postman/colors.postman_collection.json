      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/product-master/colors/code/{{companyId}}/{{colorCode}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "product-master", "colors", "code", "{{companyId}}", "{{colorCode}}"]
        }
      }
    },
