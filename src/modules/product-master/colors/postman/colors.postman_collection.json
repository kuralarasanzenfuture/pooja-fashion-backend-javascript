      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"company_id\": 1,\n  \"color_code\": \"BLK\",\n  \"color_name\": \"Jet Black\",\n  \"hex_code\": \"#0A0A0A\",\n  \"description\": \"Deep black fabric shade\",\n  \"display_order\": 1,\n  \"is_active\": true\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/product-master/colors",
