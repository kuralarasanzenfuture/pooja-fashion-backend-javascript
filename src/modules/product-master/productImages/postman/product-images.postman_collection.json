{
  "info": {
    "_postman_id": "d4e5f6a7-b8c9-40d1-e2f3-456789abcdef",
    "name": "Pooja Fashion - Product Master: Product Images",
    "description": "API collection for Product Images gallery, per-product subfolders, and reordering under Product Master in Pooja Fashion ERP & POS platform.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "List Product Images",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/product-master/product-images?page=1&limit=10&company_id=1&is_active=true&sortBy=display_order&sortOrder=asc",
          "host": ["{{baseUrl}}"],
          "path": ["api", "product-master", "product-images"],
          "query": [
            { "key": "page", "value": "1" },
            { "key": "limit", "value": "10" },
            { "key": "company_id", "value": "1" },
            { "key": "product_id", "value": "1", "disabled": true },
            { "key": "variant_id", "value": "1", "disabled": true },
            { "key": "is_primary", "value": "true", "disabled": true },
            { "key": "is_active", "value": "true" },
            { "key": "search", "value": "", "disabled": true },
            { "key": "sortBy", "value": "display_order" },
            { "key": "sortOrder", "value": "asc" }
          ]
        }
      }
    },
    {
      "name": "Get Images by Product ID",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/product-master/product-images/product/{{productId}}?is_active=true",
          "host": ["{{baseUrl}}"],
          "path": ["api", "product-master", "product-images", "product", "{{productId}}"],
          "query": [
            { "key": "is_active", "value": "true" }
          ]
        }
      }
    },
    {
      "name": "Get Product Image by ID",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/product-master/product-images/{{imageId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "product-master", "product-images", "{{imageId}}"]
        }
      }
    },
    {
      "name": "Upload Product Image (Multipart)",
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "formdata",
          "formdata": [
            { "key": "company_id", "value": "1", "type": "text" },
            { "key": "product_id", "value": "1", "type": "text" },
            { "key": "variant_id", "value": "1", "type": "text" },
            { "key": "alt_text", "value": "Silk Anarkali Front View", "type": "text" },
            { "key": "display_order", "value": "0", "type": "text" },
            { "key": "is_primary", "value": "true", "type": "text" },
            { "key": "image", "type": "file", "src": "" }
          ]
        },
        "url": {
          "raw": "{{baseUrl}}/api/product-master/product-images",
          "host": ["{{baseUrl}}"],
          "path": ["api", "product-master", "product-images"]
        }
      }
    },
    {
      "name": "Update Product Image Metadata",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"alt_text\": \"Silk Anarkali - Designer Front Embroidery\",\n  \"display_order\": 1\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/product-master/product-images/{{imageId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "product-master", "product-images", "{{imageId}}"]
        }
      }
    },
    {
      "name": "Set Image as Primary",
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/product-master/product-images/{{imageId}}/set-primary",
          "host": ["{{baseUrl}}"],
          "path": ["api", "product-master", "product-images", "{{imageId}}", "set-primary"]
        }
      }
    },
    {
      "name": "Batch Reorder Images",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"items\": [\n    { \"id\": 1, \"display_order\": 0 },\n    { \"id\": 2, \"display_order\": 1 },\n    { \"id\": 3, \"display_order\": 2 }\n  ]\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/product-master/product-images/reorder",
          "host": ["{{baseUrl}}"],
          "path": ["api", "product-master", "product-images", "reorder"]
        }
      }
    },
    {
      "name": "Update Image Status",
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"is_active\": false\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/product-master/product-images/{{imageId}}/status",
          "host": ["{{baseUrl}}"],
          "path": ["api", "product-master", "product-images", "{{imageId}}", "status"]
        }
      }
    },
    {
      "name": "Delete Product Image",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/product-master/product-images/{{imageId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "product-master", "product-images", "{{imageId}}"]
        }
      }
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000" },
    { "key": "companyId", "value": "1" },
    { "key": "productId", "value": "1" },
    { "key": "imageId", "value": "1" }
  ]
}
