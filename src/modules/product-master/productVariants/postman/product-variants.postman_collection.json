{
  "info": {
    "_postman_id": "b2c3d4e5-f6a7-48b9-c0d1-23456789abcd",
    "name": "Pooja Fashion - Product Master: Product Variants",
    "description": "API collection for Product Variants (SKUs, size/color/material matrix) under Product Master in Pooja Fashion ERP & POS platform.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "List Product Variants",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/product-master/product-variants?page=1&limit=10&company_id=1&is_active=true&sortBy=sku&sortOrder=asc",
          "host": ["{{baseUrl}}"],
          "path": ["api", "product-master", "product-variants"],
          "query": [
            { "key": "page", "value": "1" },
            { "key": "limit", "value": "10" },
            { "key": "company_id", "value": "1" },
            { "key": "product_id", "value": "1", "disabled": true },
            { "key": "size_group_id", "value": "1", "disabled": true },
            { "key": "size_id", "value": "1", "disabled": true },
            { "key": "color_id", "value": "1", "disabled": true },
            { "key": "material_id", "value": "1", "disabled": true },
            { "key": "unit_id", "value": "1", "disabled": true },
            { "key": "is_default", "value": "true", "disabled": true },
            { "key": "is_active", "value": "true" },
            { "key": "search", "value": "", "disabled": true },
            { "key": "sortBy", "value": "sku" },
            { "key": "sortOrder", "value": "asc" }
          ]
        }
      }
    },
    {
      "name": "Get Variants by Product ID",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/product-master/product-variants/product/{{productId}}?is_active=true",
          "host": ["{{baseUrl}}"],
          "path": ["api", "product-master", "product-variants", "product", "{{productId}}"],
          "query": [
            { "key": "is_active", "value": "true" }
          ]
        }
      }
    },
    {
      "name": "Get Product Variant by ID",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/product-master/product-variants/{{variantId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "product-master", "product-variants", "{{variantId}}"]
        }
      }
    },
    {
      "name": "Get Product Variant by SKU",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/product-master/product-variants/company/{{companyId}}/sku/{{sku}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "product-master", "product-variants", "company", "{{companyId}}", "sku", "{{sku}}"]
        }
      }
    },
    {
      "name": "Create Product Variant",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"company_id\": 1,\n  \"product_id\": 1,\n  \"sku\": \"SILK-ANK-M-RED\",\n  \"variant_code\": \"M-RED\",\n  \"variant_name\": \"Silk Anarkali - M / Red\",\n  \"size_group_id\": 1,\n  \"size_id\": 2,\n  \"color_id\": 1,\n  \"material_id\": 1,\n  \"unit_id\": 1,\n  \"model_no\": \"MDL-2026-01\",\n  \"style_code\": \"STL-ANK-01\",\n  \"weight\": 0.65,\n  \"track_stock\": true,\n  \"allow_negative_stock\": false,\n  \"is_default\": true,\n  \"is_active\": true\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/product-master/product-variants",
          "host": ["{{baseUrl}}"],
          "path": ["api", "product-master", "product-variants"]
        }
      }
    },
    {
      "name": "Update Product Variant",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"variant_name\": \"Silk Anarkali - Size M / Royal Red\",\n  \"weight\": 0.70,\n  \"track_stock\": true\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/product-master/product-variants/{{variantId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "product-master", "product-variants", "{{variantId}}"]
        }
      }
    },
    {
      "name": "Set Variant as Default",
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/product-master/product-variants/{{variantId}}/set-default",
          "host": ["{{baseUrl}}"],
          "path": ["api", "product-master", "product-variants", "{{variantId}}", "set-default"]
        }
      }
    },
    {
      "name": "Update Variant Status",
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"is_active\": false\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/product-master/product-variants/{{variantId}}/status",
          "host": ["{{baseUrl}}"],
          "path": ["api", "product-master", "product-variants", "{{variantId}}", "status"]
        }
      }
    },
    {
      "name": "Delete Product Variant",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/product-master/product-variants/{{variantId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "product-master", "product-variants", "{{variantId}}"]
        }
      }
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000" },
    { "key": "companyId", "value": "1" },
    { "key": "productId", "value": "1" },
    { "key": "variantId", "value": "1" },
    { "key": "sku", "value": "SILK-ANK-M-RED" }
  ]
}
