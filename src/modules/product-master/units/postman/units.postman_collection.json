        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"unit_name\": \"Pieces (Each)\",\n  \"decimal_places\": 0,\n  \"is_active\": true\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/product-master/units/{{unitId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "product-master", "units", "{{unitId}}"]
        }
      }
    },
