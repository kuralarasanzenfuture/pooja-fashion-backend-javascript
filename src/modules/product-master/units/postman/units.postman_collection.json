  "item": [
    {
      "name": "List Units",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/product-master/units?page=1&limit=10&company_id=1&is_active=true&sortBy=unit_name&sortOrder=asc",
          "host": ["{{baseUrl}}"],
          "path": ["api", "product-master", "units"],
          "query": [
            { "key": "page", "value": "1" },
            { "key": "limit", "value": "10" },
            { "key": "company_id", "value": "1" },
            { "key": "is_active", "value": "true" },
            { "key": "search", "value": "", "disabled": true },
            { "key": "sortBy", "value": "unit_name" },
            { "key": "sortOrder", "value": "asc" }
          ]
        }
      }
    },
    {
      "name": "Get Unit by ID",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/product-master/units/{{unitId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "product-master", "units", "{{unitId}}"]
        }
      }
    },
    {
      "name": "Get Unit by Code",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/product-master/units/code/{{companyId}}/{{unitCode}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "product-master", "units", "code", "{{companyId}}", "{{unitCode}}"]
        }
      }
    },
    {
      "name": "Get Company Units",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/product-master/units/company/{{companyId}}?is_active=true",
          "host": ["{{baseUrl}}"],
          "path": ["api", "product-master", "units", "company", "{{companyId}}"],
          "query": [{ "key": "is_active", "value": "true" }]
        }
      }
    },
    {
      "name": "Create Unit",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"company_id\": 1,\n  \"unit_code\": \"PCS\",\n  \"unit_name\": \"Pieces\",\n  \"decimal_places\": 0,\n  \"is_active\": true\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/product-master/units",
          "host": ["{{baseUrl}}"],
          "path": ["api", "product-master", "units"]
        }
      }
    },
