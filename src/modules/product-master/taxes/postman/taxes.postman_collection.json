  "item": [
    {
      "name": "1. Seed Standard GST Slabs",
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/taxes/seed/1",
          "host": ["{{base_url}}"],
          "path": ["api", "taxes", "seed", "1"]
        }
      }
    },
    {
      "name": "2. Calculate Tax (Exclusive Intra-state)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"amount\": 1000.00,\n  \"rate\": 18.00,\n  \"is_inter_state\": false,\n  \"is_inclusive\": false\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/taxes/calculate",
          "host": ["{{base_url}}"],
          "path": ["api", "taxes", "calculate"]
        }
      }
    },
    {
      "name": "3. Calculate Tax (Inclusive Inter-state)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"amount\": 1180.00,\n  \"rate\": 18.00,\n  \"is_inter_state\": true,\n  \"is_inclusive\": true\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/taxes/calculate",
          "host": ["{{base_url}}"],
          "path": ["api", "taxes", "calculate"]
        }
      }
    },
    {
      "name": "4. List Taxes",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/taxes?company_id=1&page=1&limit=20&sort_by=rate&sort_order=asc",
          "host": ["{{base_url}}"],
          "path": ["api", "taxes"],
          "query": [
            { "key": "company_id", "value": "1" },
            { "key": "page", "value": "1" },
            { "key": "limit", "value": "20" },
            { "key": "sort_by", "value": "rate" },
            { "key": "sort_order", "value": "asc" }
          ]
        }
      }
    },
    {
      "name": "5. Get Tax By ID",
      "request": {
        "method": "GET",
        "header": [],
