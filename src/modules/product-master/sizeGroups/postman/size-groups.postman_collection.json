  "item": [
    {
      "name": "List Size Groups",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/product-master/size-groups?page=1&limit=10&company_id=1&is_active=true&sortBy=size_group_name&sortOrder=asc",
          "host": ["{{baseUrl}}"],
          "path": ["api", "product-master", "size-groups"],
          "query": [
            { "key": "page", "value": "1" },
            { "key": "limit", "value": "10" },
            { "key": "company_id", "value": "1" },
            { "key": "is_active", "value": "true" },
            { "key": "search", "value": "", "disabled": true },
            { "key": "sortBy", "value": "size_group_name" },
            { "key": "sortOrder", "value": "asc" }
          ]
        }
      }
    },
    {
      "name": "Get Size Group by ID",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/product-master/size-groups/{{sizeGroupId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "product-master", "size-groups", "{{sizeGroupId}}"]
        }
      }
    },
    {
      "name": "Get Size Group by Code",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/product-master/size-groups/code/{{companyId}}/{{sizeGroupCode}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "product-master", "size-groups", "code", "{{companyId}}", "{{sizeGroupCode}}"]
        }
      }
    },
    {
