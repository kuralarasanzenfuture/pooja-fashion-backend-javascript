      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/product-master/size-groups/company/{{companyId}}?is_active=true",
          "host": ["{{baseUrl}}"],
          "path": ["api", "product-master", "size-groups", "company", "{{companyId}}"],
          "query": [{ "key": "is_active", "value": "true" }]
        }
      }
    },
    {
      "name": "Create Size Group",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"company_id\": 1,\n  \"size_group_code\": \"MEN\",\n  \"size_group_name\": \"Men\",\n  \"description\": \"Standard menswear apparel sizing\",\n  \"is_active\": true\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/product-master/size-groups",
          "host": ["{{baseUrl}}"],
          "path": ["api", "product-master", "size-groups"]
        }
      }
    },
