      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"size_group_name\": \"Men's Apparel & Formal\",\n  \"description\": \"Shirts, suits, kurtas, and trousers sizing\"\n}"
        },
        "url": {
