{
  "info": {
    "_postman_id": "c3d4e5f6-a7b8-49c0-d1e2-3456789abcde",
    "name": "Pooja Fashion - Product Master: Product Barcodes",
    "description": "API collection for Product Barcodes and POS Barcode Scanner under Product Master in Pooja Fashion ERP & POS platform.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "List Product Barcodes",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/product-master/product-barcodes?page=1&limit=10&company_id=1&is_active=true&sortBy=id&sortOrder=desc",
          "host": ["{{baseUrl}}"],
          "path": ["api", "product-master", "product-barcodes"],
          "query": [
            { "key": "page", "value": "1" },
            { "key": "limit", "value": "10" },
            { "key": "company_id", "value": "1" },
            { "key": "product_id", "value": "1", "disabled": true },
            { "key": "variant_id", "value": "1", "disabled": true },
            { "key": "barcode_type", "value": "EAN13", "disabled": true },
            { "key": "is_primary", "value": "true", "disabled": true },
            { "key": "is_active", "value": "true" },
            { "key": "search", "value": "", "disabled": true },
            { "key": "sortBy", "value": "id" },
            { "key": "sortOrder", "value": "desc" }
          ]
        }
      }
    },
    {
      "name": "POS Scan Barcode Lookup",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/product-master/product-barcodes/scan/{{companyId}}/{{barcode}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "product-master", "product-barcodes", "scan", "{{companyId}}", "{{barcode}}"]
        }
      }
    },
    {
      "name": "Get Barcodes by Variant ID",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/product-master/product-barcodes/variant/{{variantId}}?is_active=true",
          "host": ["{{baseUrl}}"],
          "path": ["api", "product-master", "product-barcodes", "variant", "{{variantId}}"],
          "query": [
            { "key": "is_active", "value": "true" }
          ]
        }
      }
    },
    {
      "name": "Get Product Barcode by ID",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/product-master/product-barcodes/{{barcodeId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "product-master", "product-barcodes", "{{barcodeId}}"]
        }
      }
    },
    {
      "name": "Create Product Barcode",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"company_id\": 1,\n  \"product_id\": 1,\n  \"variant_id\": 1,\n  \"barcode\": \"8901234567890\",\n  \"barcode_type\": \"EAN13\",\n  \"is_primary\": true,\n  \"is_active\": true\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/product-master/product-barcodes",
          "host": ["{{baseUrl}}"],
          "path": ["api", "product-master", "product-barcodes"]
        }
      }
    },
    {
      "name": "Update Product Barcode",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"barcode\": \"8901234567899\",\n  \"barcode_type\": \"CODE128\",\n  \"is_primary\": true\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/product-master/product-barcodes/{{barcodeId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "product-master", "product-barcodes", "{{barcodeId}}"]
        }
      }
    },
    {
      "name": "Set Barcode as Primary",
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/product-master/product-barcodes/{{barcodeId}}/set-primary",
          "host": ["{{baseUrl}}"],
          "path": ["api", "product-master", "product-barcodes", "{{barcodeId}}", "set-primary"]
        }
      }
    },
    {
      "name": "Update Barcode Status",
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"is_active\": false\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/product-master/product-barcodes/{{barcodeId}}/status",
          "host": ["{{baseUrl}}"],
          "path": ["api", "product-master", "product-barcodes", "{{barcodeId}}", "status"]
        }
      }
    },
    {
      "name": "Delete Product Barcode",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/product-master/product-barcodes/{{barcodeId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "product-master", "product-barcodes", "{{barcodeId}}"]
        }
      }
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000" },
    { "key": "companyId", "value": "1" },
    { "key": "variantId", "value": "1" },
    { "key": "barcodeId", "value": "1" },
    { "key": "barcode", "value": "8901234567890" }
  ]
}
