      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/company-tax-details/1",
          "host": ["{{baseUrl}}"],
          "path": ["company-tax-details", "1"]
        },
        "description": "Fetches a company tax detail record by its primary ID."
      }
    },
    {
