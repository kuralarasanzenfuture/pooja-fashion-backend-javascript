    "name": "Pooja Fashion - Company Tax Details API",
    "description": "Comprehensive API collection for managing Company Tax Details in Pooja Fashion ERP/POS system.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Create Company Tax Detail",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"company_id\": 1,\n  \"gstin\": \"33AABCP1234F1Z5\",\n  \"pan_number\": \"AABCP1234F\",\n  \"tan_number\": \"CHEP12345A\",\n  \"gst_registration_type\": \"regular\",\n  \"gst_state_code\": \"33\",\n  \"tax_registered_name\": \"Pooja Fashion Shop Private Limited\",\n  \"is_primary\": true,\n  \"is_active\": true\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/company-tax-details",
          "host": ["{{baseUrl}}"],
          "path": ["company-tax-details"]
        },
        "description": "Creates a new company tax detail record."
      }
    },
    {
      "name": "2. Get Company Tax Details (Paginated & Filtered)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/company-tax-details?page=1&limit=10&company_id=1&gst_registration_type=regular&is_active=true&sortBy=created_at&sortOrder=desc",
          "host": ["{{baseUrl}}"],
          "path": ["company-tax-details"],
          "query": [
            {
              "key": "page",
              "value": "1"
            },
            {
              "key": "limit",
              "value": "10"
            },
            {
              "key": "company_id",
              "value": "1"
            },
            {
              "key": "gst_registration_type",
              "value": "regular"
            },
            {
              "key": "is_active",
              "value": "true"
            },
            {
              "key": "sortBy",
              "value": "created_at"
            },
            {
              "key": "sortOrder",
              "value": "desc"
            }
          ]
        },
        "description": "Retrieves paginated company tax details with filters."
      }
    },
    {
