{
  "info": {
    "_postman_id": "pooja-fashion-auth-collection",
    "name": "Pooja Fashion - Authentication Master API",
    "description": "Comprehensive API collection for Enterprise JWT Authentication, Refresh Token Rotation, Real-Time Sessions, Login History, and Password History Security.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Login",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"identifier\": \"admin\",\n  \"password\": \"SecurePass@123\",\n  \"company_id\": 1\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/auth/login",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "login"]
        }
      }
    },
    {
      "name": "2. Refresh Token",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"refresh_token\": \"{{refreshToken}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/auth/refresh-token",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "refresh-token"]
        }
      }
    },
    {
      "name": "3. Get Current Profile (/me)",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
        },
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/auth/me",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "me"]
        }
      }
    },
    {
      "name": "4. Logout Current Session",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
        },
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/auth/logout",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "logout"]
        }
      }
    },
    {
      "name": "5. Logout All Devices",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
        },
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/auth/logout-all",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "logout-all"]
        }
      }
    },
    {
      "name": "6. Get Active Sessions",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
        },
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/auth/sessions",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "sessions"]
        }
      }
    },
    {
      "name": "7. Revoke Session by ID",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
        },
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/auth/sessions/{{sessionId}}",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "sessions", "{{sessionId}}"]
        }
      }
    },
    {
      "name": "8. Get Login History",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
        },
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/auth/login-history?page=1&limit=10&status=success",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "login-history"],
          "query": [
            { "key": "page", "value": "1" },
            { "key": "limit", "value": "10" },
            { "key": "status", "value": "success" }
          ]
        }
      }
    },
    {
      "name": "9. Change Password",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
        },
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"current_password\": \"SecurePass@123\",\n  \"new_password\": \"UpdatedPass@456\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/auth/change-password",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "change-password"]
        }
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api",
      "type": "string"
    },
    {
      "key": "token",
      "value": "your_jwt_access_token_here",
      "type": "string"
    },
    {
      "key": "refreshToken",
      "value": "your_refresh_token_here",
      "type": "string"
    },
    {
      "key": "sessionId",
      "value": "your_session_uuid_here",
      "type": "string"
    }
  ]
}
