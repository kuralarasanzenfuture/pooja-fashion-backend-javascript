        "body": {
          "mode": "raw",
          "raw": "{\n  \"designation\": \"Senior General Manager\",\n  \"salary_amount\": 55000\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/employees/1",
          "host": ["{{baseUrl}}"],
