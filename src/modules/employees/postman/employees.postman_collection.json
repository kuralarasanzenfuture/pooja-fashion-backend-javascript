        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
        },
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/employees/code/1/PFS-EMP001",
          "host": ["{{baseUrl}}"],
          "path": ["employees", "code", "1", "PFS-EMP001"]
        }
      }
    },
    {
