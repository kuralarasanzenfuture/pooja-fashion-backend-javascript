        "method": "PATCH",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"employment_status\": \"on_leave\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/employees/1/status",
          "host": ["{{baseUrl}}"],
