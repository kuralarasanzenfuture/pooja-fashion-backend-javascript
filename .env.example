NODE_ENV=development

PORT=5000

DATABASE_URL="postgresql://root:admin@localhost:5432/pooja_fashion"

JWT_ACCESS_SECRET="CHANGE_THIS_TO_A_LONG_RANDOM_SECRET"
JWT_REFRESH_SECRET="CHANGE_THIS_TO_ANOTHER_LONG_RANDOM_SECRET"

JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

CORS_ORIGIN="http://localhost:5173"

UPLOAD_DIR="./uploads"

MAX_FILE_SIZE=5242880

LOG_LEVEL="dev"

# API Debugging is controlled directly inside src/config/env.js:
# defaultMethodConfig: { GET: true, POST: true, PUT: false, PATCH: true, DELETE: false, OPTIONS: false }
# In production (NODE_ENV=production), API debugging is completely disabled regardless of method settings.
# Optional overrides:
# LOG_METHODS="GET,POST,PATCH"
